/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "api-japan-disaster-relief",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-23",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"ai": {
		"binding": "AI" // Workers AI：翻译主通道 @cf/meta/m2m100-1.2b（本地 dev 需 wrangler login，未登录时自动回退 Gemini）
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "japan-disaster-relief-db",
			"database_id": "0571713b-a816-43e1-9a76-36c3cb8f0ef7", // real remote DB (created 2026-07-26, region APAC); you still work local-only
			"migrations_dir": "migrations"
		}
	],
	"observability": {
		"enabled": true
	}
}
